{
  "name": "frontend",
  "version": "1.0.0",
  "description": "",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "desktop": "electron electron/main.cjs",
    "dist:linux": "electron-builder --linux dir",
    "dist:win": "electron-builder --win dir"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "com.salazar.desktop",
    "productName": "SALAZAR",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../runtime/backend",
        "to": "backend"
      },
      {
        "from": "../runtime/rag",
        "to": "rag"
      }
    ],
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Utility"
    },
    "win": {
      "target": [
        "dir"
      ]
    }
  }
}
